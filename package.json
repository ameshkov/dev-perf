{
  "name": "dev-perf",
  "version": "0.1.0",
  "description": "Measure developer contributions to git repositories and produce a JSON report of per-user metrics",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "dev-perf": "./build/index.js"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.14.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameshkov/dev-perf.git"
  },
  "homepage": "https://github.com/ameshkov/dev-perf#readme",
  "bugs": {
    "url": "https://github.com/ameshkov/dev-perf/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.app.json && node scripts/copy-assets.mjs && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules build",
    "format:check": "prettier --check --no-error-on-unmatched-pattern --cache . && markdownlint-cli2 \"**/*.{md,markdown}\"",
    "format:fix": "prettier --write --no-error-on-unmatched-pattern --cache . && markdownlint-cli2 --fix \"**/*.{md,markdown}\"",
    "lint": "oxlint src && pnpm knip",
    "lint:fix": "oxlint src --fix",
    "knip": "knip --production",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "prepare": "husky || true"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "git",
    "analytics",
    "metrics",
    "reporting",
    "cli"
  ],
  "author": "Andrey Meshkov <am@adguard.com>",
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "@types/node": "26.1.2",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.11",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "execa": "10.0.1",
    "vega": "6.3.1",
    "vega-lite": "6.4.3",
    "zod": "4.4.3"
  }
}

# dev-perf — environment variables template.
# Copy this file to .env and fill in real values. .env is gitignored
# and auto-loaded by dev-perf (dotenv) at startup.
#
# Every command-line option of the `report` command has a DEV_PERF_*
# environment variable equivalent; the flag wins when both are set.
# All variables are optional.
#
# Repositories to analyze when no <repo...> arguments are passed
# (comma-separated list):
# DEV_PERF_REPOS=https://github.com/org/repo.git,/path/to/local/repo

# Analyzed author-date range (any git date format):
# DEV_PERF_SINCE=2026-01-01
# DEV_PERF_UNTIL=2026-06-30

# Split the range into UTC-aligned periods (day/week/month/quarter/year).
# Requires DEV_PERF_SINCE:
# DEV_PERF_UNIT=month

# Write the JSON report to this file instead of stdout:
# DEV_PERF_OUTPUT=report.json

# Cache directory for cloned repos and LLM results:
# DEV_PERF_CACHE_DIR=.dev-perf/cache

# Boolean options accept 1/true/yes/on (on) and 0/false/no/off (off):
# DEV_PERF_REFRESH=true     # force re-clone and re-analysis
# DEV_PERF_NO_LLM=true      # deterministic stats only, skip LLM analysis
# DEV_PERF_VERBOSE=true     # verbose logging

# LLM analysis provider — dev-perf never reads the user's global
# opencode configuration:
# DEV_PERF_MODEL=gpt-4.1
# DEV_PERF_PROVIDER_URL=https://api.openai.com/v1
# DEV_PERF_API_KEY=your_token_here
# DEV_PERF_LIMIT_CONTEXT=262144
# DEV_PERF_LIMIT_OUTPUT=65536

# Retry a failed LLM analysis up to N more times, restarting the
# opencode server between attempts (default: 2):
# DEV_PERF_LLM_RETRIES=2

# Analyze up to N repositories in parallel (default: 1). With LLM
# analysis enabled this runs up to N opencode servers concurrently:
# DEV_PERF_PARALLEL=2

# `compile` command — every option has a DEV_PERF_COMPILE_* variable
# (the flag wins when both are set):
#
# Input report file (schema v2) when no <report> argument is passed:
# DEV_PERF_COMPILE_REPORT=report.json

# Output directory for report.md and the assets/ charts:
# DEV_PERF_COMPILE_OUTPUT=dev-perf-report

# Email-to-name mappings, merging identities (comma-separated
# email=name pairs, or a JSON { "email": "Name" } file):
# DEV_PERF_COMPILE_MAP=alice+work@example.com=Alice
# DEV_PERF_COMPILE_MAPS_FILE=maps.json

# User selection (comma-separated; match display name or any email):
# DEV_PERF_COMPILE_INCLUDE_USER=Alice,bob@example.com
# DEV_PERF_COMPILE_EXCLUDE_USER=ci-bot@example.com

# Repository selection (comma-separated; as given on the command line):
# DEV_PERF_COMPILE_REPO=https://github.com/org/repo-a.git
# DEV_PERF_COMPILE_EXCLUDE_REPO=https://github.com/org/legacy.git

# dev-perf — environment variables template.
# Copy this file to .env and fill in real values. .env is gitignored.
#
# All variables are optional:
#
# DEV_PERF_API_KEY=your_token_here
#   Provider API key for the LLM analysis layer. Alternative to the
#   --api-key CLI flag; the flag wins when both are set.
#
# The LLM layer also requires --model and --provider-url to be passed
# explicitly on the command line — dev-perf never reads the user's
# global opencode configuration.

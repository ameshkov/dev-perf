# dev-perf — environment variables template.
# Copy this file to .env and fill in real values. .env is gitignored
# and auto-loaded by dev-perf (dotenv) at startup.
#
# .env is NOT an option source: options come from command-line flags
# and the YAML config file (--config <path>, or ./config.yaml when it
# exists). .env exists to provide values for ${ENV_VAR} references
# inside config.yaml — the standard way to keep secrets such as the
# API key out of version control. All variables are optional.
#
# The LLM provider configuration is referenced from config.yaml, so
# none of it needs to live in version control — the same pattern as
# the API key:
#
#   model: ${DEV_PERF_MODEL}
#   provider-url: ${DEV_PERF_PROVIDER_URL}
#   api-key: ${DEV_PERF_API_KEY}
#
# reads these values at startup:
DEV_PERF_MODEL=gpt-4.1
DEV_PERF_PROVIDER_URL=https://api.openai.com/v1
DEV_PERF_API_KEY=your_token_here
#
# Note: dotenv does not override values already exported in the shell.
